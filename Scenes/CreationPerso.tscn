[node name="RLabelStatVille" type="RichTextLabel" parent="MargeInfoVille/Layout/HLayout" unique_id=613713677]
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_font_sizes/normal_font_size = 17
bbcode_enabled = true
text = "- Comté de Rose Vallée, Royaume Humain.
- 25 000 habitants
- 90% Humain, 5% Nain, 5% Autre.
- Taux de criminalité : faible
- Académie magique : Non
- Guilde de mercenaire : Non 
- Richesse de la population : 5/10
- Biome : Vallée
- Biomes à proximité : Vallée, Rivière, Montagne rocheuse."
vertical_alignment = 1

[node name="RlabelDescriptionVille" type="RichTextLabel" parent="MargeInfoVille/Layout" unique_id=399138422]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_font_sizes/normal_font_size = 22
bbcode_enabled = true
text = "Préfecture de son comté, la petite commune de Rose-Vallée cherche un maitre de guilde depuis longtemps pour ne plus dépendre des comtés voisin en matière de guilde magique. Au cœur des grandes vallées du royaume Humain, Rose-Vallée est une petite commune paisible installée au bord de la rivière Tangue. Elle vit principalement du commerce de fleurs."
horizontal_alignment = 1
vertical_alignment = 1

